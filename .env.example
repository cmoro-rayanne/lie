# Painel administrativo: copie para .env.local e preencha (nunca commitar valores reais)

# Connection string do Neon Postgres (injetada pela integração do Vercel Marketplace)
DATABASE_URL=

# Chave da API do Resend (injetada pela integração do Vercel Marketplace)
RESEND_API_KEY=

# URL pública do site, com protocolo (ex.: https://ilelino.vercel.app)
APP_URL=

# Código de convite exigido no cadastro; use 24+ caracteres aleatórios
ADMIN_INVITE_CODE=

# Remetente dos e-mails transacionais (domínio verificado no Resend)
MAIL_FROM=
